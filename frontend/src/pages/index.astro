				animation: drift 18s ease-in-out infinite;
			}
			@media (prefers-color-scheme: dark) {
				body {
					background: linear-gradient(120deg, #00E0FF, #0084FF);
					animation: none;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				body { animation: none; }
			}

			.wallet-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.5em;
			}
			.wallet-btn img {
				border-radius: 0.25em;
			}

