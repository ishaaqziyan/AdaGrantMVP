    "milestone_escrow/types/Datum": {
      "title": "Datum",
      "description": "State of a milestone-based grant escrow, held inline at the script UTxO.\n\n `tranche_bps`, `approved` are parallel lists, one entry per milestone\n (index 0..length-1). `tranche_bps` must sum to 10000 (basis points) and\n is fixed for the lifetime of the escrow; `total_locked` is the ADA\n amount originally deposited, used as the fixed base for every tranche\n percentage so payouts don't drift as the script balance shrinks.\n\n `receipt_policy_id` lives in the datum rather than as a validator\n parameter: `milestone_escrow`'s own script hash is a parameter of\n `milestone_receipt`, so making the receipt policy ID a parameter of\n `milestone_escrow` in turn would make the two scripts' hashes depend on\n each other -- unresolvable. Setting it at escrow-creation time (after\n `milestone_receipt` has already been compiled against the escrow's\n hash) breaks the cycle.",
      "anyOf": [
        {
          "title": "Datum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "reviewer",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            },
            {
              "title": "proposer",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            },
            {
              "title": "total_locked",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "tranche_bps",
              "$ref": "#/definitions/List<Int>"
            },
            {
              "title": "approved",
              "$ref": "#/definitions/List<Bool>"
            },
            {
              "title": "released_count",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "receipt_policy_id",
              "$ref": "#/definitions/cardano~1assets~1PolicyId"
            }
          ]
        }
      ]
    },
